    {
      "id": "c9-8urbNYcsV1Dou_bKHj",
      "type": "text",
      "x": 242.68527395186015,
      "y": 172.367801377996,
      "width": 641,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
